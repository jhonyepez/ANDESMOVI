rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar: verifica si usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función auxiliar: verifica si es Administrador del sistema
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin_general' || 
         request.auth.token.role == 'superadmin' ||
         request.auth.token.email == 'admin@andesmovi.ec');
    }
    
    // Colección: usuarios (perfiles básicos)
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Solo el usuario puede actualizar datos personales; saldo y rol solo por admin
      allow update: if isAuthenticated() && 
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['saldo_billetera_usd', 'rol'])) ||
        isAdmin();
      allow delete: if isAdmin();
    }
    
    // Colección: conductores (expedientes, documentos de verificación, licencias)
    match /conductores/{conductorId} {
      allow read: if isAuthenticated() && (request.auth.uid == conductorId || isAdmin());
      allow write: if isAdmin();
      // Chofer puede enviar sus fotos de documentos al registrarse
      allow create, update: if isAuthenticated() && request.auth.uid == conductorId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estado_aprobacion', 'saldo_billetera']);
    }
    
    // Colección: unidades (vehículos y placas registradas)
    match /unidades/{unidadId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Colección: carreras (viajes, estados: pendiente, en_curso, finalizado)
    // Regla de negocio: $1.25 base cubre hasta 2.7 km
    match /carreras/{carreraId} {
      allow read: if isAuthenticated() && 
        (resource.data.cliente_id == request.auth.uid || 
         resource.data.conductor_id == request.auth.uid || 
         resource.data.estado == 'pendiente' || 
         isAdmin());
      allow create: if isAuthenticated() && request.resource.data.cliente_id == request.auth.uid;
      allow update: if isAuthenticated() && 
        (resource.data.cliente_id == request.auth.uid || 
         resource.data.conductor_id == request.auth.uid || 
         isAdmin());
      allow delete: if isAdmin();
      
      // Subcolección: mensajes de chat dentro de la carrera
      match /mensajes/{mensajeId} {
        allow read, write: if isAuthenticated() && 
          (get(/databases/$(database)/documents/carreras/$(carreraId)).data.cliente_id == request.auth.uid ||
           get(/databases/$(database)/documents/carreras/$(carreraId)).data.conductor_id == request.auth.uid ||
           isAdmin());
      }
    }
    
    // Colección: encomiendas (guías y tracking interprovincial)
    match /encomiendas/{encomiendaId} {
      allow read: if isAuthenticated() && 
        (resource.data.remitente_id == request.auth.uid || 
         resource.data.transportista_id == request.auth.uid || 
         isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (resource.data.transportista_id == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Colección: recargas_billetera (comprobantes bancarios)
    match /recargas/{recargaId} {
      allow read: if isAuthenticated() && 
        (resource.data.conductor_id == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
        request.resource.data.conductor_id == request.auth.uid &&
        request.resource.data.numero_comprobante != null;
      // Solo el Administrador puede cambiar el estado a 'aprobada' o 'rechazada'
      allow update, delete: if isAdmin();
    }
  }
}
